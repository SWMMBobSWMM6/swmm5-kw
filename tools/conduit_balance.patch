+// ---- diagnostic (tools/conduit_balance.patch, not part of the engine): per-conduit volume balance ----
+static double *DbgQin = NULL, *DbgQout = NULL, *DbgImb = NULL, *DbgCapSteps = NULL;
+static void dbgInit(void) { int n = Nobjects[LINK]; if (DbgQin) return;
+  DbgQin = calloc(n, sizeof(double)); DbgQout = calloc(n, sizeof(double)); DbgImb = calloc(n, sizeof(double)); DbgCapSteps = calloc(n, sizeof(double)); }
+static void dbgBook(double dt) { int j; for (j = 0; j < Nobjects[LINK]; j++) { if (Link[j].type != CONDUIT) continue;
+  DbgImb[j] += (DbgQin[j] - DbgQout[j]) * dt - (Link[j].newVolume - Link[j].oldVolume);
+  if (Conduit[Link[j].subIndex].capacityLimited) DbgCapSteps[j] += 1; } }
+void dbgReport(void) { int j, k, n = Nobjects[LINK]; double tot = 0; if (!DbgImb) return;
+  for (j = 0; j < n; j++) tot += DbgImb[j];
+  fprintf(stderr, "DBG total conduit imbalance %.1f ft3\n", tot);
+  for (k = 0; k < 8; k++) { int b = -1; for (j = 0; j < n; j++) if (DbgImb[j] != 0 && (b < 0 || fabs(DbgImb[j]) > fabs(DbgImb[b]))) b = j;
+    if (b < 0 || fabs(DbgImb[b]) < 1) break;
+    fprintf(stderr, "DBG link %-12s imb %12.1f ft3  steps at cap %6.0f  upstream node %s%s\n", Link[b].ID, DbgImb[b], DbgCapSteps[b], Node[Link[b].node1].ID, kwmod_isSplitNode(Link[b].node1) ? " (SPLIT)" : "");
+    DbgImb[b] = 0; } }   /* listed: clear so the next pass finds the next largest */
